rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if the authenticated user owns the resource being accessed
    function isOwner(resourceData) {
      return isAuthenticated() && request.auth.uid == resourceData.owner_id;
    }

    // Default fallback - Secure by default
    match /{document=**} {
      allow read, write: if false;
    }

    match /shops/{shopId} {
      // Anyone can read public listings (for client discovery)
      allow read: if true;
      // Vendor owners can create if they assign themselves as owner
      allow create: if isAuthenticated() && request.resource.data.owner_id == request.auth.uid;
      // Vendor owners can update/delete their own shops
      allow update, delete: if isOwner(resource.data);
    }

    match /menu_items/{itemId} {
      // Anyone can read menu items
      allow read: if true;
      // Assume owner check could be done via parent relation, but for simplicity here if it has owner_id or just relying on shop_id
      allow create, update, delete: if isAuthenticated(); // Simplified for now, would ideally check if user owns the shop_id
    }

    match /orders/{orderId} {
      // Riders and clients need to read/update orders.
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /rider_profiles/{riderId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /rider_connections/{connId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
