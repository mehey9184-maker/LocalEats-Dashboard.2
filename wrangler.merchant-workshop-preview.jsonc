{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Dedicated public fictional demo. NEVER assign a LocalEats Production domain.
  "name": "localeats-merchant-workshop-preview",
  "main": "preview/merchant-workshop/worker.ts",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-merchant-workshop",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "observability": {"enabled": false},
  "routes": []
}
