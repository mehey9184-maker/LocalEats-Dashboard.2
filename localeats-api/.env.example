PORT=4000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
MERCHANT_DASHBOARD_ORIGIN=
# Optional: both values are required to allow matching HTTPS Vercel Preview hostnames.
MERCHANT_DASHBOARD_PREVIEW_HOST_PREFIX=
MERCHANT_DASHBOARD_PREVIEW_HOST_SUFFIX=
# Optional: one exact Super Admin browser origin. Leave blank until it is deployed.
SUPER_ADMIN_ORIGIN=
CUSTOMER_APP_ORIGIN=
RIDER_APP_ORIGIN=
# At least 32 random characters. Used only by the API to derive and verify
# delivery PIN/QR proofs; never expose this value to a frontend.
DELIVERY_PROOF_SECRET=
