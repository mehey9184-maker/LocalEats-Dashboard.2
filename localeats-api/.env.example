PORT=4000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
MERCHANT_DASHBOARD_ORIGIN=
# Optional: both values are required to allow matching HTTPS Vercel Preview hostnames.
MERCHANT_DASHBOARD_PREVIEW_HOST_PREFIX=
MERCHANT_DASHBOARD_PREVIEW_HOST_SUFFIX=
# Optional: one exact Super Admin browser origin. Leave blank until it is deployed.
SUPER_ADMIN_ORIGIN=
CUSTOMER_APP_ORIGIN=
RIDER_APP_ORIGIN=
# At least 32 random characters. Used only by the API to derive and verify
# delivery PIN/QR proofs; never expose this value to a frontend.
DELIVERY_PROOF_SECRET=


# R5.2E: dedicated Vercel staging API ONLY. Do not enable in Production.
# Set LOCALEATS_STAGING_ONLY=true only in the independent API Preview project.
# Set SUPABASE_SECRET_KEY directly as a Vercel SENSITIVE Preview-only variable,
# using a modern sb_secret_... key from LocalEats-Profile-Staging (never paste in git).
# Set FIREBASE_CLIENT_EMAIL and FIREBASE_PRIVATE_KEY from the SAME localeats-staging
# Firebase Admin service account, also SENSITIVE Preview-only in Vercel.
# Never configure SUPABASE_SERVICE_ROLE_KEY in the dedicated R5.2E staging API.
# Require exact HTTPS CUSTOMER_APP_ORIGIN after an isolated Customer URL is verified.
# The opt-in startup gate refuses incomplete stage identity, credentials, URL, flags,
# emulator override or Vercel Production targeting before serving any requests.
